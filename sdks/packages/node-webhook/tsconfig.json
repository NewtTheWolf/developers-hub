{
  "compilerOptions": {
    "target": "ES2020",
    // Mirrors the sibling SDK package; "lib" drops DOM because a webhook
    // receiver is a server and the module leans on node:crypto.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist/cjs",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
